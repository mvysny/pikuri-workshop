#!/usr/bin/env ruby
# frozen_string_literal: true

# Dev / demo entry point — runs from a source checkout only. The pikuri
# gem ships as a library; this script is not installed by `gem install
# pikuri-mcp`. It is the worked example of book/mcp.md: a
# minimal agent wired to exactly one MCP server — the community
# Open Library catalogue reader (https://github.com/8enSmith/mcp-open-library)
# running inside a locally-built container (podman when installed, else
# docker).
#
# The registry below is HARDCODED on purpose. This binary exists so that
# chapter's reader can watch the pikuri-mcp machinery fire end-to-end
# (verifier pass, synthesizer pass, `mcp_connect` activation) without
# first editing anything. `bin/pikuri-code` keeps an empty registry slot
# to hand-edit your own servers into.
#
# The toolset is deliberately tiny: the Open Library MCP tools plus
# `calculator`, nothing else. The server talks to the public internet
# (an outbound leg) and returns catalogue text pikuri didn't author
# (untrusted content) — two legs of the lethal trifecta. The third leg,
# private data, is structurally absent: no files, no memory, no token,
# nothing of yours is wired in, so a misbehaving server has nothing to
# exfiltrate. Keep it that way — pikuri's security chapter
# (https://github.com/mvysny/pikuri/blob/master/book/security.md)
# says why, before you bolt more tools onto this agent.
#
# Prerequisite: build the server image once, from a pinned checkout you
# have read (the chapter walks through it):
#
#   git clone --branch v1.2.6 https://github.com/8enSmith/mcp-open-library
#   cd mcp-open-library
#   podman build -f <workshop>/pikuri-mcp/containers/mcp-open-library.Containerfile \
#                -t mcp-open-library:1.2.6 .
#
# Same Bundler bootstrap as the other bundled bins so callers don't need
# the `bundle exec` ceremony.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../../Gemfile', __dir__)

require 'bundler/setup'
require 'optparse'
require 'yaml'
require 'reline' # line editing + history for the interactive prompt

require 'pikuri-core'
require 'pikuri-mcp'

# Example-only config: the LLM connection + provider API keys live verbatim
# in a YAML file the user owns — no CLI flags, never the environment (see
# pikuri's AGENTS.md "Environment is not a secret store"). Shared by convention across
# the example scripts; chmod 600 it. Absent file ⇒ {} ⇒ built-in defaults.
examples_config_path = File.expand_path('~/.pikuri-examples-config.yaml')
examples_config = File.exist?(examples_config_path) ? (YAML.safe_load_file(examples_config_path) || {}) : {}

server = examples_config['llm_server'] || 'http://localhost:8080'
model = examples_config['llm_model'] || 'unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M'
streaming = false

custom_prompt = nil
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-openlibrary [options] [initial message...]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--system-prompt FILE', "Replace the built-in system prompt with FILE's contents " \
                                  '(extensions still append their own sections).') do |v|
    custom_prompt = File.read(v).rstrip
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

cancel_flag = Pikuri::Agent::Control::Cancellable.new

system_prompt = custom_prompt || Pikuri.prompts(:'pikuri-openlibrary', :'agent-loop')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

# Podman when installed: rootless and daemonless, so there is no socket for
# any process in your account to ask for a root container. Docker otherwise.
engine = %w[podman docker].find do |bin|
  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, bin)) }
end
abort 'Neither podman nor docker is on PATH; book/mcp.md says how to get one.' if engine.nil?

image = 'mcp-open-library:1.2.6'

# The one hardcoded MCP server. The argv is the exact `run` command the
# chapter smoke-tests by hand: `-i` keeps stdin open for the JSON-RPC pipe,
# `--rm` deletes the container when the agent closes. The next three take
# away what the server never needs: every capability, any privilege gain
# through setuid binaries, and a writable filesystem. The network stays
# open: the server needs openlibrary.org, and this box can reach far more
# than that (the chapter's "What the box can reach"). To pikuri this is just
# a subprocess that speaks MCP; the container is the boundary around the
# server's npm dependency tree.
mcp_registry = Pikuri::Mcp::Registry.new(entries: [
  Pikuri::Mcp::Registry::StdioEntry.new(
    id:      'openlibrary',
    command: [engine, 'run', '-i', '--rm',
              '--cap-drop=all', '--security-opt=no-new-privileges', '--read-only',
              image]
  )
])

# Run one agent turn, trapping SIGINT only for the duration of the turn.
# Ctrl+C during a turn flips the agent's Cancellable flag — the next
# tool-call boundary raises Cancelled, which we rescue below to return to
# the prompt. Outside a turn (at the `> ` input) the default handler is
# restored so Ctrl+C still exits the REPL the way it did before.
def run_turn(agent, message)
  agent.cancellable&.reset!
  prev_trap = trap('INT') { agent.cancellable&.cancel! }
  agent.run_loop(user_message: message)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  # Notice already rendered by the Terminal listener; nothing else to do.
rescue RubyLLM::ContextLengthExceededError => e
  warn "\nContext window exhausted: #{e.message}"
  warn 'The conversation has grown too large for the model. Start a fresh question.'
  exit 1
ensure
  trap('INT', prev_trap || 'DEFAULT')
end

transport = Pikuri::Agent::ChatTransport.from_openai_server(
  server: server,
  model: model,
  api_key: examples_config.fetch('llm_api_key', 'not-needed')
)

# Boot-time LLM work: the verifier and the synthesizer each run a one-shot
# thinker agent per server on a cold cache (the Open Library server ships no
# useful `instructions`, so the synthesizer fires). Both honor cancel_flag, so
# a Ctrl+C unwinds the build. The catalog spawns the server, learns its tools
# and closes it again; the agent starts its own on the first tool call.
prev_boot_trap = trap('INT') { cancel_flag.cancel! }
begin
  mcp_catalog = Pikuri::Mcp::Catalog.build(mcp_registry, transport: transport, cancellable: cancel_flag)
rescue Pikuri::Agent::Control::Cancellable::Cancelled
  warn 'Cancelled during startup'
  exit 130
rescue Pikuri::Mcp::Verifier::InjectionDetected => e
  # The demo exists for this one server; without it there is nothing to do.
  warn 'The prompt-injection verifier rejected the Open Library MCP server:'
  warn e.message
  exit 1
ensure
  trap('INT', prev_boot_trap || 'DEFAULT')
end

# A spawn failure (missing image, no container engine) is logged as a warning
# and the server is left out of the catalog — the agent would boot with no MCP
# tools at all, which defeats the whole demo. Fail loud with the build hint.
unless mcp_catalog.include?('openlibrary')
  containerfile = File.expand_path('../containers/mcp-open-library.Containerfile', __dir__)
  warn 'The Open Library MCP server failed to start (see the warning above).'
  warn "Did you build the #{image} image? One-time setup:"
  warn '  git clone --branch v1.2.6 https://github.com/8enSmith/mcp-open-library'
  warn "  cd mcp-open-library && #{engine} build -f #{containerfile} -t #{image} ."
  warn 'book/mcp.md is the full walkthrough.'
  exit 1
end

agent = Pikuri::Agent.new(
  transport: transport,
  system_prompt: system_prompt,
  cancellable: cancel_flag,
  streaming: streaming
) do |c|
  c.add_listener Pikuri::Agent::Listener::Terminal.new(streaming: streaming)
  c.add_listener Pikuri::Agent::Listener::TokenLog.new
  # Calculator is the only bundled tool. No web tools, no files, no
  # memory — the private-data leg of the trifecta stays amputated
  # (see the header comment).
  c.add_tool Pikuri::Tool::CALCULATOR
  c.add_extension Pikuri::Mcp::Extension.new(catalog: mcp_catalog)
end

begin
  # Capability + trifecta map, printed unconditionally. These are teaching
  # binaries and the map is half the lesson; a production host puts it behind
  # an explicit ask instead.
  puts agent.trifecta.render
  puts
  puts 'Pikuri Open Library: a one-MCP demo agent over the public Open Library book catalogue.'
  puts 'Try: "What editions of The Hobbit are there?" or "What did Ursula K. Le Guin write?"'
  puts 'Press Ctrl+C or Ctrl+D to quit.'

  run_turn(agent, ARGV.join(' ')) unless ARGV.empty?

  loop do
    line = Reline.readline('> ', true) # arrow-key history + line editing
    break if line.nil? # Ctrl+D / EOF on empty line

    message = line.chomp
    next if message.strip.empty?

    run_turn(agent, message)
  end
rescue Interrupt
  # Ctrl+C — fall through to clean exit
ensure
  # Fires the extension's on_close, which tears the MCP subprocess (and
  # with it the --rm container) down, if a tool call ever started one.
  agent.close
end

puts
puts 'Goodbye'
